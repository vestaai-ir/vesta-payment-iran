<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="payment_provider_form" model="ir.ui.view">
        <field name="name">Bank Mellat Provider Form</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <group name="provider_credentials" position="inside">
                <group invisible="code != 'mellat'" colspan="2">
                    <field name="mellat_terminal_id" string="Terminal ID" required="code == 'mellat' and is_live" placeholder="e.g. 1234567"/>
                    <field name="mellat_username" string="Username" required="code == 'mellat' and is_live"/>
                    <field name="mellat_password" string="Password" required="code == 'mellat' and is_live" password="True"/>
                    <field name="mellat_api" widget="radio" options="{'horizontal': true}"/>
                </group>
            </group>
        </field>
    </record>

</odoo>
