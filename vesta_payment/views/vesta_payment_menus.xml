<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_vesta_payment_docs" model="ir.actions.act_url">
        <field name="name">Documentation</field>
        <field name="url">https://github.com/vestaai-ir/vesta-payment-iran#readme</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_vesta_payment_root"
              name="Vesta Gateway"
              web_icon="vesta_payment,static/description/icon.png"
              action="action_vesta_payment_bank"
